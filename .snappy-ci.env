# snappy-ci config. After editing: snappy-ci render .
DEFAULT_BRANCH=develop
# COVERAGE_MIN: macOS line-coverage floor. PLATFORMS / SIM_TESTS: see snappy-ci README.
KIND=package
SCHEME=SnappyBT
TEST_ON=macos
COVERAGE_MIN=100
COVERAGE_IGNORE=SnappyBT/CoreBluetooth
PLATFORMS=iOS
EXAMPLE_PROJECT=Example/SnappyBTDemo.xcodeproj
EXAMPLE_SCHEME=SnappyBTDemo
APP_PROJECT=
APP_SCHEME=
RUNNER=macos-26
HYGIENE=full
API_CHECK=true
SIM_TESTS=iOS
SANITIZE=thread
WARNINGS_AS_ERRORS=true
MERGE_FORWARD=false
TIMEOUT=20
PR_REQUIRED=false
ENFORCE_ADMINS=true
DEPENDABOT=false
PUSH_BRANCHES=develop, 'release/**'
IOS_SIMULATOR=iPhone 17
RELEASE_LINES=16 18 26
LATEST_TAG=false
